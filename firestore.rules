rules_version = '2';

// =====================================================================
// 쌉가능 (영작 트레이너) — Firestore 보안 규칙  [승인제 · 역할 4단]
// ---------------------------------------------------------------------
//  ▣ 무엇이 바뀌었나
//    예전: allowedEmails() 명단에 있는 사람만 로그인 (학생 추가할 때마다 배포)
//    지금: 누구나 로그인 → 'pending'(신청) 상태로 기록 → 선생님이 앱에서 승인
//          → 승인된 사람만 실제 데이터 사용. 학생 추가에 배포가 필요 없음.
//
//  ▣ 역할 4단
//    운영진(admin)  : 전체 권한 + 승인/거절
//    교사(teacher)  : 학생 관리 + 승인/거절
//    행정(staff)    : 열람만 (수정·승인 불가)
//    학생(student)  : 자기 진도만. 단 '승인' 이후에만
//
//  ▣ 사람이 바뀌면 아래 세 목록만 고치고 배포하세요 (소문자)
//     firebase deploy --only firestore:rules
//     ※ 학생은 여기에 넣지 않습니다 — 앱에서 승인하면 됩니다.
//     ※ concat() 쓰지 말 것 (컴파일은 되지만 실행 시 권한 오류 — 실제 사고 이력)
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 운영진 ----
    function adminEmails() {
      return [
        'joon.kim@educclesia.com'
      ];
    }
    // ---- 교사 ----
    function teacherOnlyEmails() {
      return [
        'judy.hong@eliteopenschool.org',
        'eunji.ahn@eliteopenschool.org',
        'jeein.kang@eliteopenschool.org',
        'sol.park@eliteopenschool.org'
      ];
    }
    // ---- 행정 (열람만) — 이메일이 정해지면 여기에 추가 ----
    function staffEmails() {
      return [
        'no-staff-yet@example.invalid'
      ];
    }
    // ---------------------------------------------

    function isSignedIn() { return request.auth != null; }
    // 대소문자 차이로 막히지 않도록 소문자로 맞춰서 비교합니다 (위 목록도 전부 소문자)
    function email() {
      return (isSignedIn() && request.auth.token.email != null)
        ? request.auth.token.email.lower() : '';
    }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    function isAdmin()   { return isSignedIn() && email() in adminEmails(); }
    // 레벨 조정·시험 허가 등 전체 관리 (운영진 + 교사)
    function isTeacher() { return isAdmin() || (isSignedIn() && email() in teacherOnlyEmails()); }
    function isStaff()   { return isSignedIn() && email() in staffEmails(); }
    // 관리 패널 열람 (운영진 + 교사 + 행정)
    function canView()   { return isTeacher() || isStaff(); }

    // 내 회원 문서의 승인 상태.
    // status 필드가 없는 예전 계정은 'approved'로 봅니다 (기존 학생 잠김 방지).
    function myStatus() {
      return get(/databases/$(database)/documents/members/$(request.auth.uid)).data.get('status', 'approved');
    }
    function meExists() {
      return exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // 승인된 사용자 = 교사·운영진(자동) 또는 status == 'approved'
    function isApproved() {
      return isTeacher() || (isSignedIn() && meExists() && myStatus() == 'approved');
    }

    // ── 회원 문서 ──────────────────────────────────────────────
    match /members/{uid} {

      // 읽기: 본인 + 관리 열람 권한자 (학생은 자기 승인 상태를 봐야 하므로 승인 전에도 읽기 허용)
      allow read: if isOwner(uid) || canView();

      // 생성: 본인 문서만. 관리 계정(운영진·교사·행정)이 아니면 반드시 'pending'으로 시작
      //       (스스로 approved로 만들어 들어오는 것을 차단)
      allow create: if isOwner(uid)
                    && request.resource.data.email == email()
                    && (canView() || request.resource.data.status == 'pending');

      // 수정:
      //  · 교사·운영진 → 무엇이든 (승인/거절/레벨조정/시험허가)
      //  · 행정 → 등록 승인·거절만. status/decidedBy/decidedAt 외의 필드를 건드리면 거부
      //          (레벨 조정·시험 허가는 여전히 불가)
      //  · 본인 → 승인된 상태에서, status를 스스로 바꾸지 않는 한 허용
      allow update: if isTeacher()
                    || ( isStaff()
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['status','decidedBy','decidedAt']) )
                    || ( isOwner(uid) && isApproved()
                         && request.resource.data.get('status','approved')
                            == resource.data.get('status','approved') );

      // 삭제: 운영진만
      allow delete: if isAdmin();

      // 하위 컬렉션: 본인(승인 후) + 교사
      match /{sub=**} {
        allow read:  if (isOwner(uid) && isApproved()) || canView();
        allow write: if (isOwner(uid) && isApproved()) || isTeacher();
      }
    }

    // ── 스케줄러: 승인된 사람끼리 서로 열람, 쓰기는 본인만 ──
    match /streaks/{uid} {
      allow read:  if isApproved() || canView();
      allow write: if isOwner(uid) && isApproved();
    }

    // ── 응원(선택) ──
    match /cheers/{cheerId} {
      allow read:   if isApproved() || canView();
      allow create: if isApproved() && request.resource.data.from == email();
      allow update, delete: if false;
    }

    // ── 그 외 전부 차단 ──
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
